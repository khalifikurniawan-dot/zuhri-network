        # ===== LAPISAN 3 — DARK WEB =====
        12)
            start_tor
            echo -e "\n${CYAN}🧅 ZeroNet${RESET}"
            if [ -f ~/ZeroNet/zeronet.py ]; then
                echo -e "${GREEN}✅ ZeroNet terinstall${RESET}"
                cd ~/ZeroNet && python zeronet.py &
                sleep 5
                echo -e "${DIM}Buka: http://127.0.0.1:43110${RESET}"
                echo -e "${DIM}Atau akses via Tor: http://127.0.0.1:43110${RESET}"
                read -p "Buka browser? (y/n): " b
                [ "$b" = "y" ] && termux-open-url "http://127.0.0.1:43110"
            else
                echo -e "${YELLOW}⚠️  ZeroNet belum terinstall${RESET}"
                read -p "Install ZeroNet? (y/n): " i
                if [ "$i" = "y" ]; then
                    cd ~
                    git clone https://github.com/HelloZeroNet/ZeroNet.git 2>/dev/null
                    cd ~/ZeroNet
                    pip install -r requirements.txt 2>/dev/null
                    echo -e "${GREEN}✅ ZeroNet terinstall${RESET}"
                fi
            fi
            ;;
        13)
            start_tor
            echo -e "\n${CYAN}📰 ProPublica (via Tor)${RESET}"
            akses_tor "https://www.propublica.org" "ProPublica (Layer 1)"
            echo -e "${DIM}Catatan: ProPublica juga ada versi .onion${RESET}"
            akses_tor "https://propub3r6espa33w.onion" "ProPublica .onion"
            ;;
        14)
            start_tor
            read -p "🔍 Query Ahmia: " q
            if [ -n "$q" ]; then
                akses_tor "http://juhanurmihxlp77nkq76byazcldy2hlmovfu2epvl5ankdibsot4csyd.onion/search/?q=$q" "Ahmia"
            else
                akses_tor "http://juhanurmihxlp77nkq76byazcldy2hlmovfu2epvl5ankdibsot4csyd.onion" "Ahmia"
            fi
            ;;
        15)
            start_tor
            echo -e "\n${CYAN}📚 Hidden Wiki (via Tor)${RESET}"
            akses_tor "http://zqktlwi4fecvo6ri.onion/wiki/index.php/Main_Page" "Hidden Wiki"
            ;;
        16)
            start_tor
            echo -e "\n${CYAN}📖 OnionLand (via Tor)${RESET}"
            akses_tor "http://onionlandbakyt3j5.onion" "OnionLand"
            ;;
        17)
            start_tor
            echo -e "\n${CYAN}🌐 Custom .onion${RESET}"
            read -p "URL .onion: " url
            [ -n "$url" ] && akses_tor "$url" "Custom"
            ;;

        # ===== UTILITY =====
        18)
            echo -e "\n${CYAN}🛡️  Mengaktifkan Tor Shield...${RESET}"
            python ~/zuhri_os/torshield/zuhri_torshield.py
            ;;
        19)
            start_tor
            echo -e "\n${CYAN}🧪 Test Tor...${RESET}"
            echo -e "${GOLD}Test 1: IP${RESET}"
            torsocks curl -s --max-time 10 ifconfig.me
            echo ""
            echo -e "${GOLD}Test 2: Check Tor Project${RESET}"
            torsocks lynx -dump "https://check.torproject.org/" 2>/dev/null | grep -i "congratulations\|not using"
            echo ""
            echo -e "${GOLD}Test 3: Akses .onion${RESET}"
            torsocks curl -s --max-time 15 "http://zqktlwi4fecvo6ri.onion/" | head -20
            ;;
        20)
            echo -e "\n${BOLD}📊 STATUS:${RESET}"
            if pgrep -x tor > /dev/null; then
                echo -e "  Tor: ${GREEN}✅ AKTIF${RESET}"
                torsocks curl -s --max-time 5 ifconfig.me
                echo ""
            else
                echo -e "  Tor: ${RED}❌ MATI${RESET}"
            fi
            echo -e "  ZeroNet: $([ -f ~/ZeroNet/zeronet.py ] && echo '✅' || echo '❌')"
            echo -e "  Tor Shield: $([ -f ~/zuhri_os/torshield/zuhri_torshield.py ] && echo '✅' || echo '❌')"
