#!/data/data/com.termux/files/usr/bin/bash
# ZUHRI DEEP ACCESS v2.0 — LAPISAN 2 & 3
# Dengan Tor Shield + Keamanan Berlapis

clear

RESET='\033[0m'; BOLD='\033[1m'; DIM='\033[2m'
RED='\033[91m'; GREEN='\033[92m'; YELLOW='\033[93m'
CYAN='\033[96m'; GOLD='\033[93m'; MAGENTA='\033[95m'

# ===== CEK DEPENDENSI =====
if ! command -v tor > /dev/null 2>&1; then
    echo -e "${YELLOW}⚠️  Install dependensi dulu...${RESET}"
    pkg install tor torsocks lynx proxychains-ng dnscrypt-proxy curl wget -y
fi

# ===== JALANKAN TOR (OPSIONAL) =====
start_tor() {
    if ! pgrep -x "tor" > /dev/null; then
        echo -e "${CYAN}🚀 Menjalankan Tor...${RESET}"
        nohup tor > /dev/null 2>&1 &
        sleep 10
    fi
    IP_TOR=$(torsocks curl -s --max-time 5 ifconfig.me 2>/dev/null)
    if [ -n "$IP_TOR" ] && [[ ! "$IP_TOR" == *"<"* ]]; then
        echo -e "${GREEN}✅ IP Tor: $IP_TOR${RESET}"
    else
        echo -e "${YELLOW}⚠️  Tor belum siap${RESET}"
    fi
}

# ===== FUNGSI AKSES TOR =====
akses_tor() {
    local url="$1"
    local nama="$2"
    echo -e "\n${CYAN}🌐 Membuka $nama...${RESET}"
    echo -e "${DIM}URL: $url${RESET}\n"
    
    # Coba lynx dulu (teks)
    if command -v lynx > /dev/null 2>&1; then
        timeout 60 torsocks lynx "$url"
    else
        # Fallback: curl
        torsocks curl -s --max-time 30 "$url" | head -100
    fi
}

# ===== FUNGSI AKSES INTERNET BIASA =====
akses_internet() {
    local url="$1"
    local nama="$2"
    echo -e "\n${CYAN}🌐 Membuka $nama...${RESET}"
    echo -e "${DIM}URL: $url${RESET}\n"
    
    if command -v lynx > /dev/null 2>&1; then
        timeout 60 lynx "$url"
    else
        curl -s --max-time 30 "$url" | head -100
    fi
}

# ===== MENU =====
while true; do
    clear
    echo ""
    echo -e "${BOLD}${MAGENTA}╔══════════════════════════════════════════════════════════════════════╗${RESET}"
    echo -e "${BOLD}${MAGENTA}║        🌐 ZUHRI DEEP ACCESS v2.0 — LAPISAN 2 & 3                  ║${RESET}"
    echo -e "${BOLD}${MAGENTA}║        Dengan Tor Shield + Keamanan Berlapis                      ║${RESET}"
    echo -e "${BOLD}${MAGENTA}╚══════════════════════════════════════════════════════════════════════╝${RESET}"
    echo ""
    echo -e "${BOLD}${CYAN}  📚 LAPISAN 1 — SURFACE WEB (Bisa diakses langsung):${RESET}"
    echo -e "${DIM}  ──────────────────────────────────────────────────────────────────${RESET}"
    echo -e "  ${GOLD}1.${RESET} 🔍 Google           → Mesin pencari"
    echo -e "  ${GOLD}2.${RESET} 📚 Wikipedia        → Ensiklopedia bebas"
    echo -e "  ${GOLD}3.${RESET} 📰 Berita           → CNN, BBC, Al Jazeera"
    echo -e "  ${GOLD}4.${RESET} 🎥 YouTube          → Video"
    echo -e "  ${GOLD}5.${RESET} 📧 Email            → Gmail, Outlook"
    echo ""
    echo -e "${BOLD}${CYAN}  📚 LAPISAN 2 — DEEP WEB (Ilmiah & Legal):${RESET}"
    echo -e "${DIM}  ──────────────────────────────────────────────────────────────────${RESET}"
    echo -e "  ${GOLD}6.${RESET} 🔬 Google Scholar   → Pencarian ilmiah"
    echo -e "  ${GOLD}7.${RESET} 🧬 PubMed           → Biomedis"
    echo -e "  ${GOLD}8.${RESET} 📄 arXiv            → Fisika & matematika"
    echo -e "  ${GOLD}9.${RESET} 📖 ResearchGate     → Jaringan peneliti"
    echo -e "  ${GOLD}10.${RESET} 📚 Library Genesis → Buku (via Tor)"
    echo -e "  ${GOLD}11.${RESET} 🔬 Sci-Hub         → Jurnal (via Tor)"
    echo ""
    echo -e "${BOLD}${MAGENTA}  🌑 LAPISAN 3 — DARK WEB (Anonim via Tor):${RESET}"
    echo -e "${DIM}  ──────────────────────────────────────────────────────────────────${RESET}"
    echo -e "  ${GOLD}12.${RESET} 🧅 ZeroNet         → Web terdesentralisasi"
    echo -e "  ${GOLD}13.${RESET} 📰 ProPublica      → Jurnalisme investigasi"
    echo -e "  ${GOLD}14.${RESET} 🔍 Ahmia           → Pencarian .onion"
    echo -e "  ${GOLD}15.${RESET} 📚 Hidden Wiki     → Daftar situs .onion"
    echo -e "  ${GOLD}16.${RESET} 📖 OnionLand       → Direktori .onion"
