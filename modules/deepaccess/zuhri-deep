    echo -e "  ${GOLD}20.${RESET} 📊 Cek Status"
    echo -e "  ${GOLD}0.${RESET}  🚪 Keluar"
    echo ""
    read -p "  Pilih (0-20): " pilihan

    case $pilihan in
        # ===== LAPISAN 1 — SURFACE WEB =====
        1)
            read -p "🔍 Query: " q
            [ -n "$q" ] && akses_internet "https://www.google.com/search?q=$q" "Google"
            ;;
        2)
            read -p "📚 Query: " q
            [ -n "$q" ] && akses_internet "https://id.wikipedia.org/wiki/$q" "Wikipedia"
            ;;
        3)
            echo -e "\n${CYAN}Pilih berita:${RESET}"
            echo -e "  ${GOLD}1.${RESET} CNN Indonesia"
            echo -e "  ${GOLD}2.${RESET} BBC News"
            echo -e "  ${GOLD}3.${RESET} Al Jazeera"
            read -p "  Pilih: " news
            case $news in
                1) akses_internet "https://www.cnnindonesia.com" "CNN Indonesia" ;;
                2) akses_internet "https://www.bbc.com/news" "BBC News" ;;
                3) akses_internet "https://www.aljazeera.com" "Al Jazeera" ;;
            esac
            ;;
        4)
            read -p "🎥 Query YouTube: " q
            [ -n "$q" ] && akses_internet "https://m.youtube.com/results?search_query=$q" "YouTube"
            ;;
        5)
            echo -e "\n${CYAN}Pilih email:${RESET}"
            echo -e "  ${GOLD}1.${RESET} Gmail"
            echo -e "  ${GOLD}2.${RESET} Outlook"
            read -p "  Pilih: " mail
            case $mail in
                1) akses_internet "https://mail.google.com" "Gmail" ;;
                2) akses_internet "https://outlook.live.com" "Outlook" ;;
            esac
            ;;

        # ===== LAPISAN 2 — DEEP WEB =====
        6)
            read -p "🔬 Query ilmiah: " q
            [ -n "$q" ] && akses_internet "https://scholar.google.com/scholar?q=$q" "Google Scholar"
            ;;
        7)
            read -p "🧬 Query PubMed: " q
            [ -n "$q" ] && akses_internet "https://pubmed.ncbi.nlm.nih.gov/?term=$q" "PubMed"
            ;;
        8)
            read -p "📄 Query arXiv: " q
            [ -n "$q" ] && akses_internet "https://arxiv.org/search/?query=$q" "arXiv"
            ;;
        9)
            read -p "📖 Query ResearchGate: " q
            [ -n "$q" ] && akses_internet "https://www.researchgate.net/search?q=$q" "ResearchGate"
            ;;
        10)
            start_tor
            echo -e "\n${CYAN}📚 Library Genesis (via Tor)${RESET}"
            read -p "📖 Query buku: " q
            if [ -n "$q" ]; then
                akses_tor "http://libgen.rs/search.php?req=$q" "Library Genesis"
            fi
