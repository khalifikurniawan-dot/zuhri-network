            echo -e "\n${CYAN}🔬 Sci-Hub (via Tor)${RESET}"
            read -p "🔬 DOI/URL paper: " doi
            if [ -n "$doi" ]; then
                akses_tor "https://sci-hub.se/$doi" "Sci-Hub"
            fi
