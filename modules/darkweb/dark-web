# ===== CEK DEPENDENSI =====
if ! command -v tor > /dev/null 2>&1; then
    echo -e "${YELLOW}⚠️  Install Tor + tools...${RESET}"
    pkg install tor torsocks lynx curl wget -y
fi

# ===== START TOR =====
start_tor() {
    if ! pgrep -x "tor" > /dev/null; then
        echo -e "${CYAN}🚀 Menjalankan Tor...${RESET}"
        nohup tor > /dev/null 2>&1 &
        echo -e "${DIM}Menunggu Tor bootstrap...${RESET}"
        for i in $(seq 1 30); do
            sleep 1
            IP_TOR=$(torsocks curl -s --max-time 3 ifconfig.me 2>/dev/null)
            if [ -n "$IP_TOR" ] && [[ ! "$IP_TOR" == *"<"* ]]; then
                echo -e "${GREEN}✅ Tor aktif — IP: $IP_TOR${RESET}"
                return 0
            fi
            echo -ne "\r${DIM}   Menunggu... ${i}s${RESET}"
        done
        echo ""
        echo -e "${YELLOW}⚠️  Tor belum siap, tunggu...${RESET}"
        return 1
    else
        IP_TOR=$(torsocks curl -s --max-time 5 ifconfig.me 2>/dev/null)
        echo -e "${GREEN}✅ Tor sudah aktif — IP: $IP_TOR${RESET}"
        return 0
    fi
}

# ===== AKSES TOR =====
akses_tor() {
    local url="$1"
    local nama="$2"
    echo -e "\n${CYAN}🌑 Membuka $nama...${RESET}"
    echo -e "${DIM}URL: $url${RESET}\n"
    
    # Coba lynx
    if command -v lynx > /dev/null 2>&1; then
        torsocks lynx "$url"
    else
        torsocks curl -s --max-time 30 "$url" | head -100
    fi
}

