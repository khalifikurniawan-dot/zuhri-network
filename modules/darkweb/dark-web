    echo ""
    echo -e "${CYAN}🛡️  PROTEKSI AKTIF: Tor + DNSCrypt + Proxychains${RESET}"
    echo ""
    echo -e "${GOLD}Setuju dengan panduan? (1=Ya / 2=Tidak)${RESET}"
    read -p "Pilih: " setuju
    if [ "$setuju" != "1" ]; then
        echo -e "${CYAN}👋 Keluar. Aman.${RESET}"
        exit 0
    fi
}

